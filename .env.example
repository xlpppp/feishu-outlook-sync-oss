# ===== 必填（逐项说明见 docs/ENV.md）=====
# 用户浏览器访问的根 URL，无尾斜杠；须与 OAuth 回调域名一致
PUBLIC_BASE_URL=https://sync.example.com

# Cookie 会话签名：自定义随机长串（≥32 字符）
# 生成：openssl rand -hex 32
#   或：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# 加密库内 OAuth token 的 Fernet 密钥（不能用手搓普通密码）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 丢失或更换后，所有用户必须重新授权
TOKEN_ENCRYPTION_KEY=

# ----- Microsoft（个人 Outlook.com）-----
# 来源：Azure/Entra 应用注册 → 应用程序(客户端)ID、客户端密码
# 回调：{PUBLIC_BASE_URL}/oauth/microsoft/callback
# 详见 docs/ADMIN-SETUP.md
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# consumers = 仅个人账户（推荐）；common = 组织+个人
MS_AUTHORITY=https://login.microsoftonline.com/consumers
# 传给 MSAL 时不要含 offline_access/openid/profile（库会自动加；写了会报 reserved）
MS_SCOPES=Calendars.ReadWrite User.Read

# ----- 飞书开放平台 -----
# 来源：open.feishu.cn 自建应用 → App ID / App Secret
# 回调：{PUBLIC_BASE_URL}/oauth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须与开放平台「权限管理」里已开通的 scope key 完全一致，否则授权页 20043
# 双向至少含 calendar:calendar（或等价的 event create/update/delete）；申请后发布版本
# 若控制台显示的是 calendar:calendar:read 而非 :readonly，以控制台为准
# 升级写权限后，老用户需断开再连飞书
FEISHU_SCOPES=calendar:calendar calendar:calendar.event:create calendar:calendar.event:update calendar:calendar.event:delete offline_access

# ===== 双向同步日历名（建议默认；防回环专用目标）=====
# 飞书→Outlook 写入 Outlook 侧此日历（自动创建；勿当 Outlook→飞书 源）
OUTLOOK_CALENDAR_NAME=Feishu Sync
# Outlook→飞书 写入飞书侧此日历（自动创建；勿当飞书→Outlook 源）
FEISHU_SYNC_CALENDAR_NAME=Outlook Sync

# ===== 可选 =====
# 飞书→Outlook：是否跳过「订阅」日历（API role=reader / free_busy_reader）。默认 true
# 设为 false 才会在选源时考虑订阅日历（当前源仍仅为 primary）
SKIP_SUBSCRIBED_CALENDARS=true
# 定时同步间隔（分钟）。开启 push 后建议 3–5 作兜底，勿强制改为 1
SYNC_INTERVAL_MINUTES=15
SYNC_WINDOW_PAST_DAYS=7
SYNC_WINDOW_FUTURE_DAYS=60
TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:////data/sync.db
HOST=0.0.0.0
# 容器内监听端口（Docker 部署勿改，保持 8000）
PORT=8000
# 宿主机对外映射端口（8000 被占用时改这里，例如 18000）
HOST_PORT=18000
LOG_LEVEL=INFO
# 生产 HTTPS 用 true；本地 http://127.0.0.1 用 false
COOKIE_SECURE=true

# ===== 近实时推送同步（飞书事件订阅 + Microsoft Graph 变更通知）=====
# 未设置时：只要下面任一密钥非空即自动开启；显式 false 可关闭
# PUSH_SYNC_ENABLED=true
# 飞书开放平台 → 事件与回调 → 加密策略（Encrypt Key / Verification Token）
# 请求地址：{PUBLIC_BASE_URL}/webhooks/feishu
# 需订阅事件 calendar.calendar.event.changed_v4；并在用户 OAuth 后由服务调用
# 「订阅日程变更」API（仅主日历/自有源，跳过「Outlook Sync」目标与订阅日历）
FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_EVENT_VERIFICATION_TOKEN=
# Graph webhook clientState 随机串（≤128 字符）；生成：openssl rand -hex 24
# 通知 URL：{PUBLIC_BASE_URL}/webhooks/microsoft（须 HTTPS）
GRAPH_WEBHOOK_CLIENT_STATE=
# 同一用户多次推送合并窗口（秒），建议 15–30
PUSH_DEBOUNCE_SECONDS=20
# Graph 订阅在到期前多少小时续期（Outlook events 最长约 7 天）
GRAPH_SUBSCRIPTION_RENEW_HOURS=24

# ===== 管理后台（/admin）=====
# 逗号分隔的飞书 open_id；为空则 /admin 及管理 POST 返回 404（不暴露后台存在）
# 可从 users 表 feishu_open_id 或飞书开放平台获取
# ADMIN_FEISHU_OPEN_IDS=ou_xxx,ou_yyy

# ===== 每日自动备份（SQLite → 容器内 /data/backups，随 sync-data 卷一起存）=====
BACKUP_ENABLED=true
BACKUP_DIR=/data/backups
BACKUP_KEEP_DAYS=14
# 按 TIMEZONE（默认 Asia/Shanghai）每天几点备份
BACKUP_HOUR=3
BACKUP_MINUTE=15
